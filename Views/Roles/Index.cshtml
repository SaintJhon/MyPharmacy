@model IEnumerable<ApplicationRole>
@{ ViewData["Title"] = "Roles"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Roles and permissions</h1><p class="text-muted mb-0">Create roles and assign multiple permissions to each one.</p></div>
    <a asp-action="Create" class="btn btn-success">Add role</a>
</div>
<div class="table-responsive mt-4"><table class="table table-striped table-hover bg-white align-middle">
<thead class="table-light"><tr><th>Role</th><th>Description</th><th>Assigned permissions</th><th>Actions</th></tr></thead><tbody>
@foreach (var role in Model) {
<tr><td class="fw-semibold">@role.Name</td><td>@role.Description</td><td>@string.Join(", ", role.RolePermissions.Select(x => x.Permission.Name))</td>
<td><a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr>
}
</tbody></table></div>
