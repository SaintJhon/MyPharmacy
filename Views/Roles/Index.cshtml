@model IEnumerable<ApplicationRole>
@{ ViewData["Title"] = "Roles"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Roles y permisos</h1><p class="text-muted mb-0">Crea roles y asigna varios permisos a cada uno.</p></div>
    <a asp-action="Create" class="btn btn-success">Agregar rol</a>
</div>
<div class="table-responsive mt-4"><table class="table table-striped table-hover bg-white align-middle">
<thead class="table-light"><tr><th>Rol</th><th>Descripción</th><th>Permisos asignados</th><th>Acciones</th></tr></thead><tbody>
@foreach (var role in Model) {
<tr><td class="fw-semibold">@role.Name</td><td>@role.Description</td><td>@string.Join(", ", role.RolePermissions.Select(x => x.Permission.Name))</td>
<td><a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>
}
</tbody></table></div>
