@model IEnumerable<Branch>
@{ ViewData["Title"] = "Branches"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Branches</h1><p class="text-muted mb-0">Manage pharmacy locations.</p></div>
    <a asp-action="Create" class="btn btn-success">Add branch</a>
</div>
<div class="table-responsive mt-4"><table class="table table-striped table-hover bg-white align-middle">
<thead class="table-light"><tr><th>Branch name</th><th>Address</th><th>Phone</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.Name</td><td>@item.Address</td><td>@item.Phone</td><td class="text-nowrap">
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
<form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this branch?')">Delete</button></form>
</td></tr>
}
</tbody></table></div>
