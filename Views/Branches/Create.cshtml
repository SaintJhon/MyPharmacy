@model Branch
@{ ViewData["Title"] = "Agregar sucursal"; }
<div class="row"><div class="col-lg-8 col-xl-6">
<h1 class="h3 mb-3">Agregar sucursal</h1>
<form method="post" class="card page-card shadow-sm"><div class="card-body p-4">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Nombre de la sucursal</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Address" class="form-label">Dirección</label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Phone" class="form-label">Número de teléfono</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
<button type="submit" class="btn btn-success">Crear sucursal</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</div></form></div></div>
