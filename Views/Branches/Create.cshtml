@model Branch
@{ ViewData["Title"] = "Add branch"; }
<div class="row"><div class="col-lg-8 col-xl-6">
<h1 class="h3 mb-3">Add branch</h1>
<form method="post" class="card page-card shadow-sm"><div class="card-body p-4">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Branch name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Address" class="form-label">Address</label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Phone" class="form-label">Phone number</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
<button type="submit" class="btn btn-success">Create branch</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div></form></div></div>
