@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Products</h1><p class="text-muted mb-0">Manage the pharmacy product catalog.</p></div>
    <a asp-action="Create" class="btn btn-success">Add product</a>
</div>
<div class="table-responsive mt-4">
<table class="table table-striped table-hover bg-white align-middle">
    <thead class="table-light"><tr><th>Barcode</th><th>Name</th><th>Description</th><th>Sale price</th><th>Expiration date</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Barcode</td><td>@item.Name</td><td>@item.Description</td>
            <td>@item.SalePrice.ToString("C")</td><td>@item.ExpirationDate.ToString("yyyy-MM-dd")</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
