@model IEnumerable<Product>
@{ ViewData["Title"] = "Productos"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Productos</h1><p class="text-muted mb-0">Administra el catálogo de productos de la farmacia.</p></div>
    <a asp-action="Create" class="btn btn-success">Agregar producto</a>
</div>
<div class="table-responsive mt-4">
<table class="table table-striped table-hover bg-white align-middle">
    <thead class="table-light"><tr><th>Código de barras</th><th>Nombre</th><th>Descripción</th><th>Precio de venta</th><th>Fecha de vencimiento</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Barcode</td><td>@item.Name</td><td>@item.Description</td>
            <td>@item.SalePrice.ToString("C")</td><td>@item.ExpirationDate.ToString("yyyy-MM-dd")</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este producto?')">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
