@{
    ViewData["Title"] = "Panel";
}
<div class="p-4 p-lg-5 bg-white rounded-4 shadow-sm mb-4">
    <span class="badge text-bg-success mb-3">Gestión de farmacia</span>
    <h1 class="display-6 fw-bold">Bienvenido a MyPharmacy</h1>
    <p class="lead text-muted mb-0">Administra tus productos, sucursales, proveedores, usuarios, roles y permisos de acceso desde un solo lugar.</p>
</div>

<div class="row g-3">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none">
            <div class="card page-card shadow-sm h-100"><div class="card-body">
                <h2 class="h5 text-success">Productos</h2><p class="text-muted mb-0">Administra el catálogo de productos de la farmacia.</p>
            </div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Branches" asp-action="Index" class="text-decoration-none">
            <div class="card page-card shadow-sm h-100"><div class="card-body">
                <h2 class="h5 text-success">Sucursales</h2><p class="text-muted mb-0">Administra las ubicaciones de la farmacia.</p>
            </div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Suppliers" asp-action="Index" class="text-decoration-none">
            <div class="card page-card shadow-sm h-100"><div class="card-body">
                <h2 class="h5 text-success">Proveedores</h2><p class="text-muted mb-0">Mantén actualizada la información de contacto de los proveedores.</p>
            </div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Profile" asp-action="Index" class="text-decoration-none">
            <div class="card page-card shadow-sm h-100"><div class="card-body">
                <h2 class="h5 text-success">Mi perfil</h2><p class="text-muted mb-0">Actualiza tu información personal y contraseña.</p>
            </div></div>
        </a>
    </div>
</div>
