@model IEnumerable<Supplier>
@{ ViewData["Title"] = "Proveedores"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h1 class="h3 mb-1">Proveedores</h1><p class="text-muted mb-0">Administra la información y los datos de contacto de los proveedores.</p></div>
    <a asp-action="Create" class="btn btn-success">Agregar proveedor</a>
</div>
<div class="table-responsive mt-4"><table class="table table-striped table-hover bg-white align-middle">
<thead class="table-light"><tr><th>NIT</th><th>Empresa</th><th>Contacto</th><th>Teléfono</th><th>Correo electrónico</th><th>Dirección</th><th>Acciones</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.Nit</td><td>@item.CompanyName</td><td>@item.Contact</td><td>@item.Phone</td><td>@item.Email</td><td>@item.Address</td><td class="text-nowrap">
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
<form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este proveedor?')">Eliminar</button></form>
</td></tr>
}
</tbody></table></div>
